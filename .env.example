# Copy this file to .env and set a unique random secret before running.
TCC_SECRET_KEY=replace-with-a-long-random-secret

# Required to use the staff dashboard. Use a strong password.
TCC_ADMIN_EMAIL=owner@example.com
TCC_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: database file and bind settings.
# TCC_DATABASE=instance/cafe.sqlite3
# HOST=127.0.0.1
# PORT=5000
